# PolyBot supervisor unit. Copy to /etc/systemd/system/polybot.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now polybot
#   journalctl -u polybot -f
# Adjust User= and the two paths if you did not deploy to /home/polybot/PolyBot.
[Unit]
Description=PolyBot supervisor (daily trade + nightly pipeline loop)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=polybot
WorkingDirectory=/home/polybot/PolyBot
ExecStart=/usr/bin/env bash /home/polybot/PolyBot/scripts/run_polybot.sh
Restart=always
RestartSec=15
TimeoutStopSec=120
# control-group: `systemctl stop` SIGTERMs the whole cgroup, so the python bot
# (a child of the bash supervisor, which does not forward signals) gets the
# SIGTERM its graceful-teardown handler expects — with mixed, only bash got it
# and python was SIGKILLed after the timeout, losing buffered tape/micro-tape
# flushes. Re-copy + `systemctl daemon-reload` on the box to apply.
KillMode=control-group

[Install]
WantedBy=multi-user.target
