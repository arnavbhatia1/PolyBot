# PolyBot supervisor unit — EXACTLY what runs on the box (user ubuntu,
# /home/ubuntu/PolyBot). Keep it box-exact: installing an unadapted template
# once took the bot down 10 hours (nonexistent User= -> 217/USER spawn failure).
# Install: sudo cp scripts/polybot.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=PolyBot supervisor (daily trade + nightly pipeline loop)
After=network-online.target
Wants=network-online.target
# Never lock out: a transient failure storm (e.g. mid-upgrade spawn errors)
# must not permanently disarm the supervisor. RestartSec paces the retries.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/PolyBot
ExecStart=/usr/bin/env bash /home/ubuntu/PolyBot/scripts/run_polybot.sh
Restart=always
RestartSec=15
TimeoutStopSec=120
# control-group: `systemctl stop` SIGTERMs the whole cgroup so the python bot
# gets the SIGTERM its graceful teardown expects (bash does not forward it).
KillMode=control-group

[Install]
WantedBy=multi-user.target
